# Copia este archivo a .env y cambia los valores
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
# 1 = probar en local por http://localhost. 0 = servidor real (fuerza https)
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

POSTGRES_DB=besound
POSTGRES_USER=besound
POSTGRES_PASSWORD=cambia-esto

# Opcional: base de datos por URL (p. ej. Neon) en vez de POSTGRES_*
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Opcional: guardar los audios en Cloudflare R2 en vez del disco (ver docs/DESPLIEGUE.md)
# R2_BUCKET_NAME=besound
# R2_ENDPOINT_URL=https://<id de cuenta>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_DOMAIN=pub-xxxxxxxx.r2.dev

# Tamaño máximo de los audios subidos (MB)
MAX_AUDIO_UPLOAD_MB=10
