# Copia este archivo a .env y cambia los valores
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
# 1 = probar en local por http://localhost. 0 = servidor real (fuerza https)
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

POSTGRES_DB=besound
POSTGRES_USER=besound
POSTGRES_PASSWORD=cambia-esto
